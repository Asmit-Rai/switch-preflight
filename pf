#!/usr/bin/env python3
"""Run the Preflight checker from any folder, without installing anything.

    kit/pf run --project project --rules rules/approved.toml --format chat

It is the same as `python3 -m preflight ...` with the checker's folder on the path. One short,
fixed command is also easy for a person to allow-list in the agent's permission settings.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from preflight.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
